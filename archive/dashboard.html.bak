<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>Cobold POS — Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link rel="stylesheet" href="pos.css"/>
  <style>
    #btnLogoutMobile { padding: 8px 14px; font-size: 13px; font-weight: 600; }
    #btnLogoutMobile:hover { background: rgba(255,95,95,0.1); }
    .report-tabs { display: flex; gap: 6px; }
    .report-tab {
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: none;
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      cursor: pointer;
      transition: 0.2s;
    }
    .report-tab:hover { border-color: var(--accent); color: var(--accent); }
    .report-tab.active { background: var(--accent); border-color: var(--accent); color: white; font-weight: 600; }
    .chart-type-tabs { display: flex; gap: 6px; }
    .chart-type-tab {
      padding: 8px 18px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: none;
      color: var(--text-dim);
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: 0.2s;
    }
    .chart-type-tab:hover { border-color: var(--accent); color: var(--accent); }
    .chart-type-tab.active { background: var(--accent); border-color: var(--accent); color: white; font-weight: 600; }
    .admin-report-section { animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 640px) {
      #btnLogoutMobile { padding: 9px 11px; }
      #btnLogoutMobile .logout-label { display: none; }
      .report-tabs { width: 100%; }
      .report-tab { flex: 1; text-align: center; }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

</head>
<body>

<div id="loadingOverlay">COBOLD POS</div>

<!-- SIDEBAR (desktop & tablet) -->
<div class="sidebar">
  <div class="logo">Cobold POS</div>
  <nav class="nav-menu">
    <a href="dashboard.html" class="nav-item active"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <a href="kasir.html"     class="nav-item"><i class="fa-solid fa-cash-register"></i><span>Transaksi</span></a>
    <a href="admin.html"     class="nav-item admin-only"><i class="fa-solid fa-mug-hot"></i><span>Menu</span></a>
    <a href="inventory.html" class="nav-item admin-only"><i class="fa-solid fa-box"></i><span>Inventori</span></a>
    <a href="roasting.html"  class="nav-item admin-only"><i class="fa-solid fa-fire"></i><span>Roasting</span></a>
    <a href="keuangan.html"  class="nav-item admin-only"><i class="fa-solid fa-wallet"></i><span>Keuangan</span></a>
    <a href="hpp.html"       class="nav-item admin-only"><i class="fa-solid fa-calculator"></i><span>HPP</span></a>
  </nav>
  <button class="btn-logout" id="btnLogout">LOGOUT</button>
</div>

<!-- BOTTOM NAV (mobile) -->
<nav class="bottom-nav">
  <div class="bn-bar">
    <a href="dashboard.html" class="bn-item active"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <a href="kasir.html"     class="bn-item"><i class="fa-solid fa-cash-register"></i><span>Transaksi</span></a>
    <a href="admin.html"     class="bn-item admin-only"><i class="fa-solid fa-mug-hot"></i><span>Menu</span></a>
    <a href="inventory.html" class="bn-item admin-only"><i class="fa-solid fa-box"></i><span>Inventori</span></a>
    <a href="roasting.html"  class="bn-item admin-only"><i class="fa-solid fa-fire"></i><span>Roasting</span></a>
    <a href="keuangan.html"  class="bn-item admin-only"><i class="fa-solid fa-wallet"></i><span>Keuangan</span></a>
    <a href="hpp.html"       class="bn-item admin-only"><i class="fa-solid fa-calculator"></i><span>HPP</span></a>
  </div>
</nav>
<!-- MAIN CONTENT -->
<div class="main-content">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:8px">
    <div>
      <h1 style="font-size:24px;font-weight:600;margin-bottom:4px">Dashboard</h1>
      <div class="header-sub" id="userInfo">Memuat...</div>
      <div class="header-date" style="margin-top:4px" id="dateWrap">
        <i class="fa-solid fa-calendar"></i> <span id="currentDate"></span>
      </div>
    </div>
    <!-- Logout pojok kanan atas, mobile = icon only -->
    <button id="btnLogoutMobile" onclick="doLogout()"
      style="background:none;border:1px solid #444;color:#ff5f5f;
             border-radius:8px;font-family:'Inter',sans-serif;cursor:pointer;
             display:flex;align-items:center;gap:6px;
             transition:background 0.2s;flex-shrink:0">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span class="logout-label">Logout</span>
    </button>
  </div>

  <!-- Alert stok rendah -->
  <div class="alert-low" id="alertLow">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <div>
      <div class="alert-low-title">Peringatan Stok Rendah</div>
      <div class="alert-low-body" id="alertLowBody"></div>
    </div>
  </div>

  <!-- Stats (admin-only, will be moved inside report section via JS) -->
  <div class="stats-grid" id="statsGrid" style="display:none">
    <div class="stat-card">
      <h3>Pendapatan Hari Ini</h3>
      <div class="value" id="statRevToday">Rp 0</div>
      <div class="value-sub" id="statOrdToday">0 transaksi</div>
    </div>
    <div class="stat-card">
      <h3>Pendapatan Bulan Ini</h3>
      <div class="value" id="statRevMonth">Rp 0</div>
      <div class="value-sub" id="statOrdMonth">0 transaksi</div>
    </div>
    <div class="stat-card">
      <h3>Menu Aktif</h3>
      <div class="value" id="statMenu">0</div>
      <div class="value-sub">item tersedia</div>
    </div>
    <div class="stat-card">
      <h3>Total Transaksi</h3>
      <div class="value" id="statTotal">0</div>
      <div class="value-sub">all time</div>
    </div>
  </div>

  <!-- LAPORAN ADMIN-ONLY -->
  <div class="admin-report-section" id="adminReportSection" style="display:none">

    <!-- Chart Section -->
    <div class="card">
      <!-- Chart Type Toggle -->
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">
        <h2 id="chartTitle">📊 Laporan Penjualan</h2>
        <div class="chart-type-tabs">
          <button class="chart-type-tab active" onclick="switchChartType('sales',this)">Penjualan</button>
          <button class="chart-type-tab" onclick="switchChartType('margin',this)">Margin</button>
          <button class="chart-type-tab" onclick="switchChartType('overhead',this)">Overhead</button>
        </div>
      </div>
      <!-- Period Toggle -->
      <div style="display:flex;justify-content:flex-end;margin-bottom:16px">
        <div class="report-tabs">
          <button class="report-tab active" onclick="switchReportTab('daily',this)">Harian</button>
          <button class="report-tab" onclick="switchReportTab('weekly',this)">Mingguan</button>
          <button class="report-tab" onclick="switchReportTab('monthly',this)">Bulanan</button>
        </div>
      </div>
      <div class="chart-container" style="position:relative;height:300px;width:100%">
        <canvas id="salesChart"></canvas>
      </div>
    </div>

    <!-- Stats Grid (Pendapatan, Menu, Total) -->
    <div class="stats-grid" style="margin-top:16px">
      <div class="stat-card">
        <h3>Pendapatan Hari Ini</h3>
        <div class="value" id="statRevToday">Rp 0</div>
        <div class="value-sub" id="statOrdToday">0 transaksi</div>
      </div>
      <div class="stat-card">
        <h3>Pendapatan Bulan Ini</h3>
        <div class="value" id="statRevMonth">Rp 0</div>
        <div class="value-sub" id="statOrdMonth">0 transaksi</div>
      </div>
      <div class="stat-card">
        <h3>Menu Aktif</h3>
        <div class="value" id="statMenu">0</div>
        <div class="value-sub">item tersedia</div>
      </div>
      <div class="stat-card">
        <h3>Total Transaksi</h3>
        <div class="value" id="statTotal">0</div>
        <div class="value-sub">all time</div>
      </div>
    </div>

    <!-- Margin & Overhead Cards -->
    <div class="stats-grid" style="margin-top:16px">
      <div class="stat-card">
        <h3>Margin Harian</h3>
        <div class="value" id="marginDaily">Rp 0</div>
        <div class="value-sub" id="marginDailyPct">0%</div>
      </div>
      <div class="stat-card">
        <h3>Margin Mingguan</h3>
        <div class="value" id="marginWeekly">Rp 0</div>
        <div class="value-sub" id="marginWeeklyPct">0%</div>
      </div>
      <div class="stat-card">
        <h3>Margin Bulanan</h3>
        <div class="value" id="marginMonthly">Rp 0</div>
        <div class="value-sub" id="marginMonthlyPct">0%</div>
      </div>
      <div class="stat-card">
        <h3>Overhead Harian</h3>
        <div class="value" id="overheadDaily">Rp 0</div>
        <div class="value-sub">biaya operasional</div>
      </div>
      <div class="stat-card">
        <h3>Overhead Mingguan</h3>
        <div class="value" id="overheadWeekly">Rp 0</div>
        <div class="value-sub">biaya operasional</div>
      </div>
      <div class="stat-card">
        <h3>Overhead Bulanan</h3>
        <div class="value" id="overheadMonthly">Rp 0</div>
        <div class="value-sub">biaya operasional</div>
      </div>
    </div>

    <!-- Tabel Detail Margin per Menu -->
    <div class="card" style="margin-top:16px">
      <h2>💰 Detail Margin per Menu (Bulan Ini)</h2>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Menu</th><th>Terjual</th><th>Pendapatan</th><th>HPP</th><th>Margin</th><th>%</th></tr></thead>
          <tbody id="marginDetailTbody"><tr><td colspan="6" class="empty-cell">Memuat...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Transaksi terbaru -->
  <div class="card">
    <h2>Transaksi Terbaru</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Waktu</th><th>Kasir</th><th>Tipe</th><th>Total</th><th>Status</th></tr></thead>
        <tbody id="recentTbody"><tr><td colspan="5" class="empty-cell">Memuat...</td></tr></tbody>
      </table>
    </div>
  </div>

  <!-- Status stok -->
  <div class="card">
    <h2>Status Stok Bahan</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Bahan Baku</th><th>Sisa</th><th>Status</th></tr></thead>
        <tbody id="stockTbody"><tr><td colspan="3" class="empty-cell">Memuat...</td></tr></tbody>
      </table>
    </div>
  </div>
</div><!-- /main-content -->

<script type="module">
  import { initializeApp }  from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
  import { getFirestore, collection, getDocs, doc, getDoc, query, orderBy }
    from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

  const fc = {
    apiKey:"AIzaSyAIBQseS7GTzddBODZcLm-iD_ol79rL6PA",
    authDomain:"cobold-b0e8d.firebaseapp.com",
    projectId:"cobold-b0e8d",
    storageBucket:"cobold-b0e8d.firebasestorage.app",
    messagingSenderId:"317072309656",
    appId:"1:317072309656:web:803003d311f119e437bfed"
  };
  const app=initializeApp(fc), auth=getAuth(app), db=getFirestore(app);

  document.getElementById('currentDate').textContent = new Date().toLocaleDateString('id-ID',{
    weekday:'long', year:'numeric', month:'long', day:'numeric'
  });

  onAuthStateChanged(auth, async(user) => {
    if (!user) { location.href="login.html"; return; }
    const snap = await getDoc(doc(db,"users",user.uid));
    if (!snap.exists()) { await signOut(auth); location.href="login.html"; return; }
    const { role, name } = snap.data();
    document.getElementById('userInfo').textContent = (role==='admin'?'👑 Admin':'☕ Kasir')+': '+(name||user.email);

    // Tampilkan nav admin dan laporan admin
    if (role === 'admin') {
      document.body.classList.add('is-admin');
      document.getElementById('adminReportSection').style.display = 'block';
    } else {
      // Kasir: hide stats grid completely
      document.getElementById('statsGrid').style.display = 'none';
    }

    await loadData();
    document.getElementById('loadingOverlay').style.display = 'none';
  });

  let salesChart = null;
  let allOrders = [];
  let currentChartType = 'sales'; // 'sales' | 'margin' | 'overhead'
  let currentPeriod = 'daily'; // 'daily' | 'weekly' | 'monthly' 

  async function loadData() {
    try {
      // Orders
      const oSnap  = await getDocs(query(collection(db,"orders"), orderBy("createdAt","desc")));
      allOrders = oSnap.docs.map(d=>({id:d.id,...d.data()}));
      const now    = new Date();
      const todayS = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const monthS = new Date(now.getFullYear(), now.getMonth(), 1);
      let rt=0,ot=0,rm=0,om=0;
      allOrders.filter(o=>o.status!=='cancelled').forEach(o=>{
        const ts = o.createdAt?.toDate ? o.createdAt.toDate() : new Date((o.createdAt?.seconds||0)*1000);
        if(ts>=todayS){rt+=o.total||0;ot++;}
        if(ts>=monthS){rm+=o.total||0;om++;}
      });
      document.getElementById('statRevToday').textContent = 'Rp '+rt.toLocaleString('id');
      document.getElementById('statOrdToday').textContent = ot+' transaksi';
      document.getElementById('statRevMonth').textContent = 'Rp '+rm.toLocaleString('id');
      document.getElementById('statOrdMonth').textContent = om+' transaksi';
      document.getElementById('statTotal').textContent    = allOrders.length;

      // Recent 5
      const tbody  = document.getElementById('recentTbody');
      const recent = allOrders.slice(0,5);
      tbody.innerHTML = recent.length ? recent.map(o=>{
        const ts  = o.createdAt?.toDate ? o.createdAt.toDate() : new Date((o.createdAt?.seconds||0)*1000);
        const cls = o.status==='done'?'badge-green':o.status==='cancelled'?'badge-red':'badge-yellow';
        return `<tr>
          <td>${ts.toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}</td>
          <td>${o.kasirName||'—'}</td>
          <td>${o.type==='dine-in'?`Dine-in #${o.tableNo||'?'}`:'Takeaway'}</td>
          <td>Rp ${(o.total||0).toLocaleString('id')}</td>
          <td><span class="badge ${cls}">${o.status}</span></td>
        </tr>`;
      }).join('') : `<tr><td colspan="5" class="empty-cell">Belum ada transaksi.</td></tr>`;

      // Menu count
      const mSnap = await getDocs(collection(db,"menu"));
      document.getElementById('statMenu').textContent = mSnap.docs.filter(d=>d.data().available!==false).length;

      // Ingredients
      const iSnap = await getDocs(collection(db,"ingredients"));
      const ings  = iSnap.docs.map(d=>({id:d.id,...d.data()}));
      const low   = ings.filter(i=>i.minStock>0 && i.stock<=i.minStock);

      document.getElementById('stockTbody').innerHTML = ings.length ? ings.map(i=>{
        const r   = i.minStock>0 ? i.stock/i.minStock : 2;
        const cls = r<=0?'badge-red':r<=0.5?'badge-red':r<=1?'badge-yellow':'badge-green';
        const lbl = r<=0?'HABIS':r<=0.5?'KRITIS':r<=1?'RENDAH':'AMAN';
        return `<tr><td>${i.name}</td><td>${i.stock} ${i.unit}</td><td><span class="badge ${cls}">${lbl}</span></td></tr>`;
      }).join('') : `<tr><td colspan="3" class="empty-cell">Belum ada data stok.</td></tr>`;

      if (low.length) {
        document.getElementById('alertLow').classList.add('show');
        document.getElementById('alertLowBody').innerHTML = low.map(i=>`• ${i.name}: ${i.stock} ${i.unit}`).join('<br>');
      }

      // Load admin reports if admin
      const userSnap = await getDoc(doc(db,"users",auth.currentUser.uid));
      if (userSnap.exists() && userSnap.data().role === 'admin') {
        await loadAdminReports();
      }
    } catch(e) { console.error(e); }
  }

  // ── ADMIN REPORTS ──
  async function loadAdminReports() {
    // Load menu data first for accurate overhead calculation
    await loadMenuData();

    const doneOrders = allOrders.filter(o => o.status === 'done');

    // Daily chart (last 7 days)
    renderDailyChart(doneOrders);

    // Calculate margins & overhead
    calculateMargins(doneOrders);

    // Detail margin per menu
    renderMarginDetail(doneOrders);
  }

  function getOrderDate(o) {
    return o.createdAt?.toDate ? o.createdAt.toDate() : new Date((o.createdAt?.seconds||0)*1000);
  }

  function renderDailyChart(orders) {
    const days = [];
    const labels = [];
    const now = new Date();
    for (let i = 6; i >= 0; i--) {
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
      days.push(d);
      labels.push(d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric' }));
    }

    const data = days.map(day => {
      const start = new Date(day.getFullYear(), day.getMonth(), day.getDate());
      const end = new Date(day.getFullYear(), day.getMonth(), day.getDate() + 1);
      const dayOrders = orders.filter(o => {
        const ts = getOrderDate(o);
        return ts >= start && ts < end;
      });

      if (currentChartType === 'sales') {
        return dayOrders.reduce((s, o) => s + (o.total || 0), 0);
      } else if (currentChartType === 'margin') {
        return dayOrders.reduce((s, o) => s + ((o.total || 0) - (o.hpp || 0)), 0);
      } else if (currentChartType === 'overhead') {
        // Calculate actual overhead from menu data
        let overhead = 0;
        dayOrders.forEach(o => {
          (o.items || []).forEach(item => {
            const menu = menuDataCache.find(m => m.id === item.id);
            if (menu && menu.hpp) {
              overhead += (menu.hpp.overhead || 0) * (item.qty || 1);
            }
          });
        });
        return overhead;
      }
      return 0;
    });

    const chartLabels = {
      sales: 'Penjualan (Rp)',
      margin: 'Margin (Rp)',
      overhead: 'Overhead (Rp)'
    };
    const chartColors = {
      sales: { bg: 'rgba(210, 160, 110, 0.7)', border: 'rgba(210, 160, 110, 1)' },
      margin: { bg: 'rgba(34, 197, 94, 0.7)', border: 'rgba(34, 197, 94, 1)' },
      overhead: { bg: 'rgba(239, 68, 68, 0.7)', border: 'rgba(239, 68, 68, 1)' }
    };
    const color = chartColors[currentChartType] || chartColors.sales;

    const ctx = document.getElementById('salesChart').getContext('2d');
    if (salesChart) salesChart.destroy();

    salesChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: chartLabels[currentChartType] || chartLabels.sales,
          data: data,
          backgroundColor: color.bg,
          borderColor: color.border,
          borderWidth: 1,
          borderRadius: 6,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                return 'Rp ' + context.raw.toLocaleString('id');
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: '#888',
              callback: function(value) {
                return 'Rp ' + (value / 1000).toFixed(0) + 'k';
              }
            },
            grid: { color: 'rgba(255,255,255,0.05)' }
          },
          x: {
            ticks: { color: '#888' },
            grid: { display: false }
          }
        }
      }
    });
  }

  function renderWeeklyChart(orders) {
    const weeks = [];
    const labels = [];
    const now = new Date();
    for (let i = 3; i >= 0; i--) {
      const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - (now.getDay() + i * 7));
      weeks.push(weekStart);
      labels.push('Minggu ' + (4 - i));
    }

    const data = weeks.map((weekStart, idx) => {
      const weekEnd = idx < weeks.length - 1 ? weeks[idx + 1] : new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
      const weekOrders = orders.filter(o => {
        const ts = getOrderDate(o);
        return ts >= weekStart && ts < weekEnd;
      });

      if (currentChartType === 'sales') {
        return weekOrders.reduce((s, o) => s + (o.total || 0), 0);
      } else if (currentChartType === 'margin') {
        return weekOrders.reduce((s, o) => s + ((o.total || 0) - (o.hpp || 0)), 0);
      } else if (currentChartType === 'overhead') {
        let overhead = 0;
        weekOrders.forEach(o => {
          (o.items || []).forEach(item => {
            const menu = menuDataCache.find(m => m.id === item.id);
            if (menu && menu.hpp) {
              overhead += (menu.hpp.overhead || 0) * (item.qty || 1);
            }
          });
        });
        return overhead;
      }
      return 0;
    });

    const chartLabels = {
      sales: 'Penjualan (Rp)',
      margin: 'Margin (Rp)',
      overhead: 'Overhead (Rp)'
    };
    const chartColors = {
      sales: { bg: 'rgba(210, 160, 110, 0.15)', border: 'rgba(210, 160, 110, 1)', point: 'rgba(210, 160, 110, 1)' },
      margin: { bg: 'rgba(34, 197, 94, 0.15)', border: 'rgba(34, 197, 94, 1)', point: 'rgba(34, 197, 94, 1)' },
      overhead: { bg: 'rgba(239, 68, 68, 0.15)', border: 'rgba(239, 68, 68, 1)', point: 'rgba(239, 68, 68, 1)' }
    };
    const color = chartColors[currentChartType] || chartColors.sales;

    const ctx = document.getElementById('salesChart').getContext('2d');
    if (salesChart) salesChart.destroy();

    salesChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: chartLabels[currentChartType] || chartLabels.sales,
          data: data,
          backgroundColor: color.bg,
          borderColor: color.border,
          borderWidth: 2,
          fill: true,
          tension: 0.4,
          pointRadius: 4,
          pointBackgroundColor: color.point
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                return 'Rp ' + context.raw.toLocaleString('id');
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: '#888',
              callback: function(value) {
                return 'Rp ' + (value / 1000).toFixed(0) + 'k';
              }
            },
            grid: { color: 'rgba(255,255,255,0.05)' }
          },
          x: {
            ticks: { color: '#888' },
            grid: { display: false }
          }
        }
      }
    });
  }

  function renderMonthlyChart(orders) {
    const months = [];
    const labels = [];
    const now = new Date();
    for (let i = 5; i >= 0; i--) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      months.push(d);
      labels.push(d.toLocaleDateString('id-ID', { month: 'short', year: '2-digit' }));
    }

    const data = months.map((monthStart, idx) => {
      const monthEnd = idx < months.length - 1 ? months[idx + 1] : new Date(now.getFullYear(), now.getMonth() + 1, 1);
      const monthOrders = orders.filter(o => {
        const ts = getOrderDate(o);
        return ts >= monthStart && ts < monthEnd;
      });

      if (currentChartType === 'sales') {
        return monthOrders.reduce((s, o) => s + (o.total || 0), 0);
      } else if (currentChartType === 'margin') {
        return monthOrders.reduce((s, o) => s + ((o.total || 0) - (o.hpp || 0)), 0);
      } else if (currentChartType === 'overhead') {
        let overhead = 0;
        monthOrders.forEach(o => {
          (o.items || []).forEach(item => {
            const menu = menuDataCache.find(m => m.id === item.id);
            if (menu && menu.hpp) {
              overhead += (menu.hpp.overhead || 0) * (item.qty || 1);
            }
          });
        });
        return overhead;
      }
      return 0;
    });

    const chartLabels = {
      sales: 'Penjualan (Rp)',
      margin: 'Margin (Rp)',
      overhead: 'Overhead (Rp)'
    };
    const chartColors = {
      sales: { bg: 'rgba(210, 160, 110, 0.7)', border: 'rgba(210, 160, 110, 1)' },
      margin: { bg: 'rgba(34, 197, 94, 0.7)', border: 'rgba(34, 197, 94, 1)' },
      overhead: { bg: 'rgba(239, 68, 68, 0.7)', border: 'rgba(239, 68, 68, 1)' }
    };
    const color = chartColors[currentChartType] || chartColors.sales;

    const ctx = document.getElementById('salesChart').getContext('2d');
    if (salesChart) salesChart.destroy();

    salesChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels,
        datasets: [{
          label: chartLabels[currentChartType] || chartLabels.sales,
          data: data,
          backgroundColor: color.bg,
          borderColor: color.border,
          borderWidth: 1,
          borderRadius: 6,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                return 'Rp ' + context.raw.toLocaleString('id');
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              color: '#888',
              callback: function(value) {
                return 'Rp ' + (value / 1000).toFixed(0) + 'k';
              }
            },
            grid: { color: 'rgba(255,255,255,0.05)' }
          },
          x: {
            ticks: { color: '#888' },
            grid: { display: false }
          }
        }
      }
    });
  }

  window.switchChartType = function(type, btn) {
    document.querySelectorAll('.chart-type-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentChartType = type;

    const titles = {
      sales: '📊 Laporan Penjualan',
      margin: '💰 Laporan Margin',
      overhead: '🏭 Laporan Overhead'
    };
    document.getElementById('chartTitle').textContent = titles[type] || titles.sales;

    // Re-render current period with new chart type
    const doneOrders = allOrders.filter(o => o.status === 'done');
    if (currentPeriod === 'daily') renderDailyChart(doneOrders);
    else if (currentPeriod === 'weekly') renderWeeklyChart(doneOrders);
    else if (currentPeriod === 'monthly') renderMonthlyChart(doneOrders);
  };

  window.switchReportTab = function(period, btn) {
    document.querySelectorAll('.report-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentPeriod = period;

    const doneOrders = allOrders.filter(o => o.status === 'done');
    if (period === 'daily') renderDailyChart(doneOrders);
    else if (period === 'weekly') renderWeeklyChart(doneOrders);
    else if (period === 'monthly') renderMonthlyChart(doneOrders);
  };

  let menuDataCache = [];

  async function loadMenuData() {
    const snap = await getDocs(collection(db, "menu"));
    menuDataCache = snap.docs.map(d => ({ id: d.id, ...d.data() }));
  }

  function calculateMargins(orders) {
    const now = new Date();

    // Daily
    const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const todayEnd = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    const todayOrders = orders.filter(o => {
      const ts = getOrderDate(o);
      return ts >= todayStart && ts < todayEnd;
    });

    // Weekly
    const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - now.getDay());
    const weekOrders = orders.filter(o => {
      const ts = getOrderDate(o);
      return ts >= weekStart;
    });

    // Monthly
    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
    const monthOrders = orders.filter(o => {
      const ts = getOrderDate(o);
      return ts >= monthStart;
    });

    // Calculate for each period using ACTUAL overhead from menu data
    const calcPeriod = (ords) => {
      let revenue = 0, hppTotal = 0, overheadTotal = 0, bahanTotal = 0;

      ords.forEach(o => {
        revenue += (o.total || 0);
        hppTotal += (o.hpp || 0);

        // Calculate actual overhead from menu data
        (o.items || []).forEach(item => {
          const menu = menuDataCache.find(m => m.id === item.id);
          if (menu && menu.hpp) {
            const qty = item.qty || 1;
            // overhead per porsi * qty
            const itemOverhead = (menu.hpp.overhead || 0) * qty;
            overheadTotal += itemOverhead;
            // bahan = hpp total - overhead
            const itemHpp = (menu.hpp.total || 0) * qty;
            bahanTotal += (itemHpp - itemOverhead);
          }
        });
      });

      const profit = revenue - hppTotal;
      const marginPct = revenue > 0 ? ((profit / revenue) * 100).toFixed(1) : 0;

      return { revenue, hpp: hppTotal, profit, marginPct, overhead: overheadTotal, bahan: bahanTotal };
    };

    const daily = calcPeriod(todayOrders);
    const weekly = calcPeriod(weekOrders);
    const monthly = calcPeriod(monthOrders);

    // Update DOM
    document.getElementById('marginDaily').textContent = 'Rp ' + Math.round(daily.profit).toLocaleString('id');
    document.getElementById('marginDailyPct').textContent = daily.marginPct + '%';
    document.getElementById('marginDailyPct').className = 'value-sub ' + (daily.profit >= 0 ? 'profit-positive' : 'profit-negative');

    document.getElementById('marginWeekly').textContent = 'Rp ' + Math.round(weekly.profit).toLocaleString('id');
    document.getElementById('marginWeeklyPct').textContent = weekly.marginPct + '%';
    document.getElementById('marginWeeklyPct').className = 'value-sub ' + (weekly.profit >= 0 ? 'profit-positive' : 'profit-negative');

    document.getElementById('marginMonthly').textContent = 'Rp ' + Math.round(monthly.profit).toLocaleString('id');
    document.getElementById('marginMonthlyPct').textContent = monthly.marginPct + '%';
    document.getElementById('marginMonthlyPct').className = 'value-sub ' + (monthly.profit >= 0 ? 'profit-positive' : 'profit-negative');

    document.getElementById('overheadDaily').textContent = 'Rp ' + Math.round(daily.overhead).toLocaleString('id');
    document.getElementById('overheadWeekly').textContent = 'Rp ' + Math.round(weekly.overhead).toLocaleString('id');
    document.getElementById('overheadMonthly').textContent = 'Rp ' + Math.round(monthly.overhead).toLocaleString('id');
  }

  function renderMarginDetail(orders) {
    const now = new Date();
    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
    const monthOrders = orders.filter(o => {
      const ts = getOrderDate(o);
      return ts >= monthStart;
    });

    // Aggregate by menu using actual menu data for accurate HPP breakdown
    const menuStats = {};
    monthOrders.forEach(o => {
      (o.items || []).forEach(item => {
        if (!menuStats[item.id]) {
          menuStats[item.id] = { name: item.name, qty: 0, revenue: 0, hpp: 0, overhead: 0, bahan: 0 };
        }
        const qty = item.qty || 1;
        menuStats[item.id].qty += qty;
        menuStats[item.id].revenue += (item.price || 0) * qty;

        // Get actual HPP data from menu
        const menu = menuDataCache.find(m => m.id === item.id);
        if (menu && menu.hpp) {
          const itemHppTotal = (menu.hpp.total || 0) * qty;
          const itemOverhead = (menu.hpp.overhead || 0) * qty;
          const itemBahan = itemHppTotal - itemOverhead;
          menuStats[item.id].hpp += itemHppTotal;
          menuStats[item.id].overhead += itemOverhead;
          menuStats[item.id].bahan += itemBahan;
        } else {
          // Fallback: estimate from order hpp proportion
          const itemTotal = (item.price || 0) * qty;
          const orderTotal = o.total || 1;
          const itemHppShare = o.hpp ? (o.hpp * (itemTotal / orderTotal)) : 0;
          menuStats[item.id].hpp += itemHppShare;
        }
      });
    });

    const tbody = document.getElementById('marginDetailTbody');
    const rows = Object.values(menuStats).sort((a, b) => b.revenue - a.revenue);

    if (!rows.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-cell">Belum ada data penjualan bulan ini.</td></tr>';
      return;
    }

    tbody.innerHTML = rows.map(r => {
      const margin = r.revenue - r.hpp;
      const marginPct = r.revenue > 0 ? ((margin / r.revenue) * 100).toFixed(1) : 0;
      const cls = margin >= 0 ? 'profit-positive' : 'profit-negative';
      return `<tr>
        <td><strong>${r.name}</strong></td>
        <td>${r.qty}</td>
        <td>Rp ${Math.round(r.revenue).toLocaleString('id')}</td>
        <td>Rp ${Math.round(r.hpp).toLocaleString('id')}</td>
        <td class="${cls}">Rp ${Math.round(margin).toLocaleString('id')}</td>
        <td class="${cls}">${marginPct}%</td>
      </tr>`;
    }).join('');
  }

  const doLogout = () => signOut(auth).then(() => location.href = "login.html");
  window.doLogout = doLogout;
  // Sidebar logout (desktop/tablet)
  const sidebarLogout = document.getElementById('btnLogout');
  if (sidebarLogout) sidebarLogout.addEventListener('click', doLogout);
</script>
<script src="nav-scroll.js"></script>
</body>
</html>