<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <title>Cobold POS — Inventori</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
  <link rel="stylesheet" href="pos.css"/>
  <style>
    .section { display:none; } .section.active { display:block; }
    .stock-bar-wrap { display:flex; align-items:center; gap:8px; }
    .stock-bar { flex:1; height:4px; background:#2a2a2a; border-radius:4px; overflow:hidden; min-width:60px; }
    .stock-bar-fill { height:100%; border-radius:4px; transition:width .3s; }
    .fill-kritis { background:var(--red); }
    .fill-rendah { background:var(--yellow); }
    .fill-aman   { background:var(--green); }
    .unit-tag { font-size:11px; color:var(--text-dim); margin-left:3px; }
    .recipe-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
    .recipe-card { background:var(--card-bg); border:1px solid var(--border); border-radius:12px; padding:16px; }
    .recipe-card-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; }
    .recipe-name { font-weight:600; font-size:14px; margin-bottom:2px; }
    .recipe-cat  { font-size:11px; color:var(--accent); }
    .recipe-item { display:flex; justify-content:space-between; font-size:12px; padding:6px 0; border-bottom:1px solid #1a1a1a; }
    .recipe-item:last-child { border-bottom:none; }
    .recipe-item-name   { color:var(--text-dim); }
    .recipe-item-amount { color:var(--text-main); font-weight:600; }
    .recipe-empty { font-size:12px; color:var(--text-dim); font-style:italic; text-align:center; padding:10px 0; }
    .restock-info { background:#111; border-radius:9px; padding:14px; font-size:13px; margin-bottom:16px; }
    .restock-info .ri-name { font-weight:600; margin-bottom:4px; }
    .restock-info .ri-stock { color:var(--text-dim); font-size:12px; }
    .recipe-editor-item { display:flex; gap:8px; align-items:center; margin-bottom:8px; }
    .recipe-editor-item select,.recipe-editor-item input { background:#111; border:1px solid var(--border); border-radius:7px; padding:8px 10px; color:var(--text-main); font-family:'Inter',sans-serif; font-size:12px; outline:none; }
    .recipe-editor-item select { flex:2; } .recipe-editor-item input { flex:1; }
    .recipe-editor-item select:focus,.recipe-editor-item input:focus { border-color:var(--accent); }
    .unit-label { font-size:11px; color:var(--text-dim); min-width:28px; }
    .btn-remove-recipe { background:none; border:none; color:var(--red); cursor:pointer; font-size:14px; padding:0 4px; }
    .btn-add-ingredient { width:100%; padding:8px; background:none; border:1px dashed var(--border); border-radius:7px; color:var(--text-dim); font-family:'Inter',sans-serif; font-size:13px; cursor:pointer; transition:.2s; margin-top:4px; }
    .btn-add-ingredient:hover { border-color:var(--accent); color:var(--accent); }

    /* Product Grid */
    .prod-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:14px; }
    .prod-card { background:var(--card-bg); border:1px solid var(--border); border-radius:12px; padding:16px; position:relative; }
    .prod-card-head { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
    .prod-card-name { font-weight:600; font-size:15px; }
    .prod-card-cat { font-size:11px; color:var(--accent); margin-top:2px; }
    .prod-stock-row { display:flex; align-items:center; gap:8px; margin:10px 0; }
    .prod-stock-bar { flex:1; height:5px; background:#2a2a2a; border-radius:5px; overflow:hidden; }
    .prod-stock-fill { height:100%; border-radius:5px; transition:width .3s; }
    .prod-stock-text { font-size:12px; color:var(--text-dim); white-space:nowrap; }
    .prod-price-row { display:flex; justify-content:space-between; font-size:12px; margin:8px 0; padding:8px 0; border-top:1px solid #1a1a1a; border-bottom:1px solid #1a1a1a; }
    .prod-price-row span:first-child { color:var(--text-dim); }
    .prod-price-row span:last-child { color:var(--accent); font-weight:600; }
    .prod-ingredients { background:#111; border-radius:8px; padding:10px; margin-top:10px; }
    .prod-ing-title { font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px; }
    .prod-ing-item { display:flex; justify-content:space-between; font-size:12px; padding:3px 0; color:var(--text-dim); }
    .prod-ing-item span:last-child { color:var(--text-main); font-weight:500; }
    .prod-actions { display:flex; gap:6px; margin-top:12px; }
    .prod-actions .btn-sm { flex:1; justify-content:center; }
    .prod-empty { color:var(--text-dim); font-size:14px; text-align:center; padding:30px 0; }
    .prod-badge { position:absolute; top:12px; right:12px; font-size:10px; padding:2px 8px; border-radius:4px; font-weight:600; }

    /* HPP Preview in modal */
    .hpp-preview { background:#111; border-radius:9px; padding:12px; margin:12px 0; }
    .hpp-line { display:flex; justify-content:space-between; font-size:12px; padding:3px 0; color:var(--text-dim); }
    .hpp-line strong { color:var(--text-main); }
    .hpp-total { display:flex; justify-content:space-between; font-size:14px; font-weight:600; margin-top:8px; padding-top:8px; border-top:1px solid var(--border); color:var(--accent); }

    @media(max-width:640px){
      .recipe-grid { grid-template-columns:1fr; }
      .prod-grid { grid-template-columns:1fr; }
      .card-head { flex-direction:column; align-items:flex-start; }
      .card-head .btn-primary { width:100%; justify-content:center; }
      .form-row-2 { grid-template-columns:1fr; }
    }
  
    /* Modal fixes - override pos.css */
    .modal-overlay {
      align-items: center !important;
      justify-content: center !important;
      padding: 16px !important;
    }
    .modal {
      max-width: 520px !important;
      width: 100% !important;
      max-height: 85vh !important;
      transform: translateY(0) !important;
    }
    .modal-overlay.show .modal {
      transform: translateY(0) !important;
    }
    /* Recipe modal specific */
    #recipeModal .modal {
      max-width: 520px !important;
    }
</style>

</head>
<body>

<div id="loadingOverlay">COBOLD POS</div>

<!-- SIDEBAR -->
<div class="sidebar">
  <div class="logo">Cobold POS</div>
  <nav class="nav-menu">
    <a href="dashboard.html" class="nav-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <a href="kasir.html"     class="nav-item"><i class="fa-solid fa-cash-register"></i><span>Transaksi</span></a>
    <a href="admin.html"     class="nav-item admin-only"><i class="fa-solid fa-mug-hot"></i><span>Menu</span></a>
    <a href="inventory.html" class="nav-item active admin-only"><i class="fa-solid fa-box"></i><span>Inventori</span></a>
    <a href="roasting.html"  class="nav-item admin-only"><i class="fa-solid fa-fire"></i><span>Roasting</span></a>
    <a href="hpp.html"       class="nav-item admin-only"><i class="fa-solid fa-calculator"></i><span>HPP</span></a>
  </nav>
  <button class="btn-logout" id="btnLogout">LOGOUT</button>
</div>

<!-- BOTTOM NAV -->
<nav class="bottom-nav">
  <div class="bn-bar">
    <a href="dashboard.html" class="bn-item"><i class="fa-solid fa-house"></i><span>Dashboard</span></a>
    <a href="kasir.html"     class="bn-item"><i class="fa-solid fa-cash-register"></i><span>Transaksi</span></a>
    <a href="admin.html"     class="bn-item admin-only"><i class="fa-solid fa-mug-hot"></i><span>Menu</span></a>
    <a href="inventory.html" class="bn-item active admin-only"><i class="fa-solid fa-box"></i><span>Inventori</span></a>
    <a href="roasting.html"  class="bn-item admin-only"><i class="fa-solid fa-fire"></i><span>Roasting</span></a>
    <a href="hpp.html"       class="bn-item admin-only"><i class="fa-solid fa-calculator"></i><span>HPP</span></a>
  </div>
</nav>

<div class="main-content">
  <div class="header">
    <div><h1>Inventori</h1><div class="header-sub">Kelola stok bahan baku, produk jadi, resep menu, dan riwayat.</div></div>
    <div style="display:flex;gap:8px;">
      <button class="btn-primary" onclick="openProdModal()"><i class="fa-solid fa-plus"></i> Produk</button>
      <button class="btn-primary" onclick="openIngModal()"><i class="fa-solid fa-plus"></i> Bahan</button>
    </div>
  </div>

  <!-- Alert -->
  <div class="alert-low" id="alertLow">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <div>
      <div class="alert-low-title">Stok Rendah!</div>
      <div class="alert-low-body" id="alertBody"></div>
    </div>
  </div>

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('stok',this)">📦 Stok Bahan</button>
    <button class="tab-btn"        onclick="switchTab('produk',this)">🥤 Produk</button>
    <button class="tab-btn"        onclick="switchTab('resep',this)">📋 Resep Menu</button>
    <button class="tab-btn"        onclick="switchTab('log',this)">📜 Riwayat</button>
  </div>

  <!-- STOK BAHAN -->
  <div class="section active" id="tab-stok">
    <div class="card">
      <div class="card-head">
        <input class="search-input" type="text" id="searchIng" placeholder="Cari bahan..." oninput="renderIngredients()" style="width:200px"/>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Bahan</th><th>Kategori</th><th>Stok</th><th>Min</th><th>Level</th><th>Status</th><th>Aksi</th></tr></thead>
          <tbody id="ingTbody"><tr><td colspan="7" class="empty-cell">Memuat...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- PRODUK -->
  <div class="section" id="tab-produk">
    <div class="card">
      <div class="card-head">
        <input class="search-input" type="text" id="searchProd" placeholder="Cari produk..." oninput="renderProducts()" style="width:200px"/>
      </div>
      <div class="prod-grid" id="prodGrid"><p class="prod-empty">Memuat produk...</p></div>
    </div>
  </div>

  <!-- RESEP -->
  <div class="section" id="tab-resep">
    <div class="recipe-grid" id="recipeGrid"><p style="color:var(--text-dim);font-size:14px">Memuat resep...</p></div>
  </div>

  <!-- LOG -->
  <div class="section" id="tab-log">
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Waktu</th><th>Tipe</th><th>Item</th><th>Perubahan</th><th>Keterangan</th><th>Oleh</th></tr></thead>
          <tbody id="logTbody"><tr><td colspan="6" class="empty-cell">Memuat...</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- MODAL BAHAN BAKU -->
<div class="modal-overlay" id="ingModal">
  <div class="modal">
    <h2 id="ingModalTitle">Tambah Bahan</h2>
    <input type="hidden" id="ingEditId"/>
    <div class="form-group"><label>Nama Bahan</label><input type="text" id="ingName" placeholder="cth: House Blend"/></div>
    <div class="form-row-2">
      <div class="form-group"><label>Kategori</label>
        <select id="ingCat"><option>Green Bean</option><option>Roasted Bean</option><option>Kopi</option><option>Susu</option><option>Sirup</option><option>Powder</option><option>Lainnya</option></select>
      </div>
      <div class="form-group"><label>Satuan</label>
        <select id="ingUnit"><option value="g">Gram (g)</option><option value="Kg">Kilogram (Kg)</option><option value="ml">Mililiter (ml)</option><option value="L">Liter (L)</option><option value="pcs">Pieces (pcs)</option><option value="btl">Botol (btl)</option><option value="ktg">Kantong (ktg)</option><option value="karton">Karton</option></select>
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label>Stok Saat Ini</label><input type="number" id="ingStock" placeholder="0" min="0" step="0.01"/></div>
      <div class="form-group"><label>Stok Minimum</label><input type="number" id="ingMin" placeholder="0" min="0" step="0.01"/></div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label>Harga Beli (Rp)</label><input type="number" id="ingHarga" placeholder="150000" min="0" step="1"/></div>
      <div class="form-group"><label>Unit Multiplier</label><input type="number" id="ingMultiplier" placeholder="1000" min="1" step="1"/></div>
    </div>
    <div class="modal-footer">
      <button class="btn-modal-cancel" onclick="closeIngModal()">Batal</button>
      <button class="btn-modal-confirm" id="ingSaveBtn" onclick="submitIng()">Simpan</button>
    </div>
  </div>
</div>

<!-- MODAL RESTOCK BAHAN BAKU -->
<div class="modal-overlay" id="restockModal">
  <div class="modal" style="max-width:360px">
    <h2>Tambah Stok</h2>
    <input type="hidden" id="restockId"/>
    <div class="restock-info">
      <div class="ri-name" id="restockName">—</div>
      <div class="ri-stock" id="restockCurrent">Stok saat ini: —</div>
    </div>
    <div class="form-group"><label>Jumlah Penambahan</label><input type="number" id="restockAmt" placeholder="0" min="0.01" step="0.01"/></div>
    <div class="form-group"><label>Keterangan</label><input type="text" id="restockNote" placeholder="Restock mingguan"/></div>
    <div class="modal-footer">
      <button class="btn-modal-cancel" onclick="closeRestock()">Batal</button>
      <button class="btn-modal-confirm" id="restockSaveBtn" onclick="submitRestock()">Tambah Stok</button>
    </div>
  </div>
</div>

<!-- MODAL PRODUK -->
<div class="modal-overlay" id="prodModal">
  <div class="modal" style="max-width:520px">
    <h2 id="prodModalTitle">Tambah Produk</h2>
    <input type="hidden" id="prodEditId"/>
    <div class="form-group"><label>Nama Produk</label><input type="text" id="prodName" placeholder="cth: Kopi Susu Gula Aren"/></div>
    <div class="form-row-2">
      <div class="form-group"><label>Kategori</label>
        <select id="prodCat"><option>Minuman Literan</option><option>Minuman Botolan</option><option>Sauce/Syrup</option><option>Lainnya</option></select>
      </div>
      <div class="form-group"><label>Satuan</label>
        <select id="prodUnit" onchange="updateProdUnitLabels()"><option value="ml">Mililiter (ml)</option><option value="L">Liter (L)</option><option value="btl">Botol (btl)</option><option value="pcs">Pieces (pcs)</option></select>
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group"><label>Stok Awal</label><input type="number" id="prodStock" placeholder="0" min="0" step="0.01"/></div>
      <div class="form-group"><label>Stok Minimum</label><input type="number" id="prodMin" placeholder="0" min="0" step="0.01"/></div>
    </div>

    <div style="margin-top:16px">
      <label style="font-size:11px;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;display:block">Bahan Baku (per 1 ${unit})</label>
      <div id="prodEditor"></div>
      <button class="btn-add-ingredient" onclick="addProdRow()"><i class="fa-solid fa-plus"></i> Tambah Bahan</button>
    </div>

    <div class="form-row-2" style="margin-top:12px">
      <div class="form-group"><label>Overhead per <span class="prod-unit-label">L</span> (Rp)</label><input type="number" id="prodOverhead" placeholder="0" min="0" step="1" value="0" oninput="calcHPP()"/></div>
      <div class="form-group"><label>Margin Keuntungan (%)</label><input type="number" id="prodMargin" placeholder="50" min="0" step="1" value="50" oninput="calcHPP()"/></div>
    </div>

    <div class="hpp-preview" id="hppPreview">
      <div class="hpp-line"><span>HPP Bahan</span><strong id="hppBahan">Rp 0</strong></div>
      <div class="hpp-line"><span>Overhead</span><strong id="hppOverhead">Rp 0</strong></div>
      <div class="hpp-total"><span>HPP Total</span><span id="hppTotal">Rp 0</span></div>
      <div class="hpp-total" style="border-top:none;margin-top:4px;padding-top:0;color:var(--green)"><span>Harga Jual</span><span id="hppJual">Rp 0</span></div>
    </div>

    <div class="modal-footer">
      <button class="btn-modal-cancel" onclick="closeProdModal()">Batal</button>
      <button class="btn-modal-confirm" id="prodSaveBtn" onclick="submitProd()">Simpan</button>
    </div>
  </div>
</div>

<!-- MODAL RESTOCK PRODUK -->
<div class="modal-overlay" id="prodRestockModal">
  <div class="modal" style="max-width:360px">
    <h2>Tambah Stok Produk</h2>
    <input type="hidden" id="prodRestockId"/>
    <div class="restock-info">
      <div class="ri-name" id="prodRestockName">—</div>
      <div class="ri-stock" id="prodRestockCurrent">Stok saat ini: —</div>
    </div>
    <div class="form-group"><label>Jumlah Penambahan</label><input type="number" id="prodRestockAmt" placeholder="0" min="0.01" step="0.01"/></div>
    <div class="form-group"><label>Keterangan</label><input type="text" id="prodRestockNote" placeholder="Produksi batch baru"/></div>
    <div class="modal-footer">
      <button class="btn-modal-cancel" onclick="closeProdRestock()">Batal</button>
      <button class="btn-modal-confirm" id="prodRestockSaveBtn" onclick="submitProdRestock()">Tambah Stok</button>
    </div>
  </div>
</div>

<!-- MODAL RESEP MENU -->
<div class="modal-overlay" id="recipeModal">
  <div class="modal" style="max-width:520px;width:100%">
    <h2 id="recipeModalTitle">Edit Resep</h2>
    <input type="hidden" id="recipeMenuId"/>
    <p style="font-size:12px;color:var(--text-dim);margin-bottom:14px">Bahan baku per 1 porsi menu ini.</p>
    <div id="recipeEditor"></div>
    <button class="btn-add-ingredient" onclick="addRecipeRow()"><i class="fa-solid fa-plus"></i> Tambah Bahan</button>
    <div class="modal-footer">
      <button class="btn-modal-cancel" onclick="closeRecipeModal()">Batal</button>
      <button class="btn-modal-confirm" id="recipeSaveBtn" onclick="submitRecipe()">Simpan Resep</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
  import { getFirestore, collection, getDocs, addDoc, doc, getDoc, updateDoc, deleteDoc, query, orderBy, serverTimestamp, increment, writeBatch }
    from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

  const fc={apiKey:"AIzaSyAIBQseS7GTzddBODZcLm-iD_ol79rL6PA",authDomain:"cobold-b0e8d.firebaseapp.com",projectId:"cobold-b0e8d",storageBucket:"cobold-b0e8d.firebasestorage.app",messagingSenderId:"317072309656",appId:"1:317072309656:web:803003d311f119e437bfed"};
  const app=initializeApp(fc),auth=getAuth(app),db=getFirestore(app);
  let currentUser=null,ingredients=[],menuItems=[],stockLogs=[],recipeRows=[],products=[],prodRows=[];

  onAuthStateChanged(auth,async(user)=>{
    if(!user){location.href="login.html";return;}
    const snap=await getDoc(doc(db,"users",user.uid));
    if(!snap.exists()){location.href="login.html";return;}
    const role = snap.data().role || 'kasir';
    if(role === 'admin') {
      document.body.classList.add('is-admin');
    } else {
      location.href = "dashboard.html";
      return;
    }
    currentUser={uid:user.uid,name:snap.data().name||user.email};
    await Promise.all([loadIngredients(),loadMenu(),loadLogs(),loadProducts()]);
    renderIngredients();renderProducts();renderRecipes();renderLogs();checkAlerts();
    document.getElementById('loadingOverlay').style.display='none';
  });

  async function loadIngredients(){const s=await getDocs(query(collection(db,"ingredients"),orderBy("category")));ingredients=s.docs.map(d=>({id:d.id,...d.data()}));}
  async function loadMenu(){const s=await getDocs(query(collection(db,"menu"),orderBy("category")));menuItems=s.docs.map(d=>({id:d.id,...d.data()}));}
  async function loadLogs(){const s=await getDocs(query(collection(db,"stockLogs"),orderBy("createdAt","desc")));stockLogs=s.docs.map(d=>({id:d.id,...d.data()})).slice(0,80);}
  async function loadProducts(){const s=await getDocs(query(collection(db,"finishedGoods"),orderBy("category")));products=s.docs.map(d=>({id:d.id,...d.data()}));}

  window.switchTab=function(tab,btn){
    ['stok','produk','resep','log'].forEach(t=>document.getElementById('tab-'+t).classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.getElementById('tab-'+tab).classList.add('active');
    btn.classList.add('active');
    if(tab==='produk')renderProducts();
    if(tab==='resep')renderRecipes();
    if(tab==='log')renderLogs();
  };

  // ── ALERTS ──
  function checkAlerts(){
    const lowIng=ingredients.filter(i=>i.minStock>0&&i.stock<=i.minStock);
    const lowProd=products.filter(p=>p.minStock>0&&p.stock<=p.minStock);
    const allLow=[...lowIng.map(i=>`• ${i.name}: ${i.stock} ${i.unit}`),...lowProd.map(p=>`• ${p.name}: ${p.stock} ${p.unit} (produk)`)];
    if(!allLow.length){document.getElementById('alertLow').classList.remove('show');return;}
    document.getElementById('alertLow').classList.add('show');
    document.getElementById('alertBody').innerHTML=allLow.join('<br>');
  }

  // ── BAHAN BAKU (existing, unchanged) ──
  function getStatus(i){if(!i.minStock||i.minStock<=0)return'aman';const r=i.stock/i.minStock;return r<=0.5?'kritis':r<=1?'rendah':'aman';}
  function barW(i){if(!i.minStock||i.minStock<=0)return 80;return Math.min(100,Math.round((i.stock/(i.minStock*2))*100));}

  window.renderIngredients=function(){
    const q=document.getElementById('searchIng').value.toLowerCase();
    const list=ingredients.filter(i=>!q||i.name.toLowerCase().includes(q)||(i.category||'').toLowerCase().includes(q));
    document.getElementById('ingTbody').innerHTML=list.length?list.map(i=>{
      const st=getStatus(i),pct=barW(i),lbl={kritis:'KRITIS',rendah:'RENDAH',aman:'AMAN'}[st],cls={kritis:'badge-red',rendah:'badge-yellow',aman:'badge-green'}[st];
      return `<tr>
        <td><strong>${i.name}</strong></td>
        <td><span style="font-size:11px;color:var(--accent)">${i.category||'—'}</span></td>
        <td><strong>${i.stock}</strong><span class="unit-tag">${i.unit}</span></td>
        <td>${i.minStock||0}<span class="unit-tag">${i.unit}</span></td>
        <td><div class="stock-bar-wrap"><div class="stock-bar"><div class="stock-bar-fill fill-${st}" style="width:${pct}%"></div></div><span style="font-size:11px;color:var(--text-dim)">${pct}%</span></div></td>
        <td><span class="badge ${cls}">${lbl}</span></td>
        <td>
          <button class="btn-sm" style="color:var(--green);border-color:rgba(34,197,94,.3)" onclick="openRestock('${i.id}')">+ Stok</button>
          <button class="btn-sm" onclick="openIngModal('${i.id}')">Edit</button>
          <button class="btn-sm danger" onclick="deleteIng('${i.id}')">Hapus</button>
        </td>
      </tr>`;
    }).join(''):`<tr><td colspan="7" class="empty-cell">Tidak ada bahan ditemukan.</td></tr>`;
  };

  window.openIngModal=function(id){
    document.getElementById('ingEditId').value=id||'';
    if(id){const i=ingredients.find(x=>x.id===id);document.getElementById('ingModalTitle').textContent='Edit Bahan';document.getElementById('ingName').value=i.name;document.getElementById('ingCat').value=i.category||'Lainnya';document.getElementById('ingUnit').value=i.unit;document.getElementById('ingStock').value=i.stock;document.getElementById('ingMin').value=i.minStock||0;document.getElementById('ingHarga').value=i.hargaBeli||'';document.getElementById('ingMultiplier').value=i.unitMultiplier||'';}
    else{document.getElementById('ingModalTitle').textContent='Tambah Bahan';document.getElementById('ingName').value='';document.getElementById('ingStock').value='';document.getElementById('ingMin').value='';}
    document.getElementById('ingModal').classList.add('show');
  };
  window.closeIngModal=function(){document.getElementById('ingModal').classList.remove('show');};
  window.submitIng=async function(){
    const btn=document.getElementById('ingSaveBtn');
    const id=document.getElementById('ingEditId').value;
    const name=document.getElementById('ingName').value.trim();
    const cat=document.getElementById('ingCat').value;
    const unit=document.getElementById('ingUnit').value;
    const stock=parseFloat(document.getElementById('ingStock').value);
    const min=parseFloat(document.getElementById('ingMin').value)||0;
    const hargaBeli=parseFloat(document.getElementById('ingHarga').value)||0;
    const unitMultiplier=parseFloat(document.getElementById('ingMultiplier').value)||1000;
    if(!name||isNaN(stock)){toast('Nama dan stok wajib diisi.','error');return;}
    btn.disabled=true;btn.textContent='Menyimpan...';
    try{
      if(id)await updateDoc(doc(db,"ingredients",id),{name,category:cat,unit,stock,minStock:min,hargaBeli,unitMultiplier});
      else await addDoc(collection(db,"ingredients"),{name,category:cat,unit,stock,minStock:min,hargaBeli,unitMultiplier,createdAt:serverTimestamp()});
      await loadIngredients();renderIngredients();checkAlerts();closeIngModal();toast('✓ Bahan disimpan','success');
    }catch(e){toast('Error: '+e.message,'error');}
    btn.disabled=false;btn.textContent='Simpan';
  };
  window.deleteIng=async function(id){
    const i=ingredients.find(x=>x.id===id);if(!confirm(`Hapus "${i?.name}"?`))return;
    try{await deleteDoc(doc(db,"ingredients",id));await loadIngredients();renderIngredients();toast('Bahan dihapus','success');}catch(e){toast('Error: '+e.message,'error');}
  };

  window.openRestock=function(id){
    const i=ingredients.find(x=>x.id===id);
    document.getElementById('restockId').value=id;
    document.getElementById('restockName').textContent=i.name;
    document.getElementById('restockCurrent').textContent=`Stok saat ini: ${i.stock} ${i.unit}`;
    document.getElementById('restockAmt').value='';document.getElementById('restockNote').value='';
    document.getElementById('restockModal').classList.add('show');
  };
  window.closeRestock=function(){document.getElementById('restockModal').classList.remove('show');};
  window.submitRestock=async function(){
    const btn=document.getElementById('restockSaveBtn');
    const id=document.getElementById('restockId').value;
    const amt=parseFloat(document.getElementById('restockAmt').value);
    const note=document.getElementById('restockNote').value.trim()||'Restock manual';
    if(isNaN(amt)||amt<=0){toast('Jumlah tidak valid.','error');return;}
    btn.disabled=true;btn.textContent='Menyimpan...';
    try{
      const i=ingredients.find(x=>x.id===id);
      await updateDoc(doc(db,"ingredients",id),{stock:increment(amt)});
      await addDoc(collection(db,"stockLogs"),{type:'ingredient',ingredientId:id,ingredientName:i.name,unit:i.unit,change:amt,note,byName:currentUser.name,createdAt:serverTimestamp()});
      await loadIngredients();await loadLogs();renderIngredients();renderLogs();checkAlerts();closeRestock();toast(`✓ +${amt} ${i.unit} ditambahkan`,'success');
    }catch(e){toast('Error: '+e.message,'error');}
    btn.disabled=false;btn.textContent='Tambah Stok';
  };

  // ── PRODUK (FINISHED GOODS) ──
  function getProdStatus(p){if(!p.minStock||p.minStock<=0)return'aman';const r=p.stock/p.minStock;return r<=0.5?'kritis':r<=1?'rendah':'aman';}
  function prodBarW(p){if(!p.minStock||p.minStock<=0)return 80;return Math.min(100,Math.round((p.stock/(p.minStock*2))*100));}

  window.updateProdUnitLabels=function(){
    const unit=document.getElementById('prodUnit').value;
    document.querySelectorAll('.prod-unit-label').forEach(el=>el.textContent=unit);
  };
  function calcHPP(){
    let totalBahan=0;
    const unit=document.getElementById('prodUnit').value;
    document.querySelectorAll('.prod-unit-label').forEach(el=>el.textContent=unit);

    for(const r of prodRows){
      if(!r.ingredientId||!r.amount)continue;
      const ing=ingredients.find(i=>i.id===r.ingredientId);
      if(!ing||!ing.hargaBeli||!ing.unitMultiplier)continue;
      const hargaSatuan=ing.hargaBeli/ing.unitMultiplier;
      totalBahan+=hargaSatuan*r.amount;
    }

    const overhead=parseFloat(document.getElementById('prodOverhead').value)||0;
    const margin=parseFloat(document.getElementById('prodMargin').value)||0;
    const hppTotal=totalBahan+overhead;
    const hargaJual=Math.ceil(hppTotal*(1+margin/100)/1000)*1000;

    document.getElementById('hppBahan').textContent='Rp '+Math.round(totalBahan).toLocaleString('id');
    document.getElementById('hppOverhead').textContent='Rp '+Math.round(overhead).toLocaleString('id');
    document.getElementById('hppTotal').textContent='Rp '+Math.round(hppTotal).toLocaleString('id');
    document.getElementById('hppJual').textContent='Rp '+hargaJual.toLocaleString('id');

    return {totalBahan,overhead,hppTotal,hargaJual};
  }

  window.calcHPP = calcHPP;

  window.renderProducts=function(){
    const q=document.getElementById('searchProd').value.toLowerCase();
    const list=products.filter(p=>!q||p.name.toLowerCase().includes(q)||(p.category||'').toLowerCase().includes(q));
    const grid=document.getElementById('prodGrid');
    if(!list.length){grid.innerHTML=`<p class="prod-empty">Tidak ada produk ditemukan.</p>`;return;}
    grid.innerHTML=list.map(p=>{
      const st=getProdStatus(p),pct=prodBarW(p);
      const cls={kritis:'badge-red',rendah:'badge-yellow',aman:'badge-green'}[st];
      const fillCls={kritis:'fill-kritis',rendah:'fill-rendah',aman:'fill-aman'}[st];
      const ings=p.ingredients||[];
      const ingRows=ings.length?ings.map(x=>{
        const ing=ingredients.find(i=>i.id===x.ingredientId);
        return `<div class="prod-ing-item"><span>${ing?ing.name:'(dihapus)'}</span><span>${x.amount} ${ing?ing.unit:''}</span></div>`;
      }).join(''):`<div class="prod-ing-item" style="font-style:italic">Belum ada bahan baku</div>`;

      return `<div class="prod-card">
        <span class="prod-badge ${cls}">${st.toUpperCase()}</span>
        <div class="prod-card-head">
          <div>
            <div class="prod-card-name">${p.name}</div>
            <div class="prod-card-cat">${p.category||'—'}</div>
          </div>
        </div>
        <div class="prod-stock-row">
          <div class="prod-stock-bar"><div class="prod-stock-fill ${fillCls}" style="width:${pct}%"></div></div>
          <span class="prod-stock-text"><strong>${p.stock}</strong> ${p.unit} / min ${p.minStock||0}</span>
        </div>
        <div class="prod-price-row">
          <span>HPP: Rp ${Math.round(p.hppTotal||0).toLocaleString('id')}</span>
          <span>Jual: Rp ${Math.round(p.hargaJual||0).toLocaleString('id')}</span>
        </div>
        <div class="prod-ingredients">
          <div class="prod-ing-title">Bahan Baku per 1 ' + p.unit + '</div>
          ${ingRows}
        </div>
        <div class="prod-actions">
          <button class="btn-sm" style="color:var(--green);border-color:rgba(34,197,94,.3)" onclick="openProdRestock('${p.id}')">+ Stok</button>
          <button class="btn-sm" onclick="openProdModal('${p.id}')">Edit</button>
          <button class="btn-sm danger" onclick="deleteProd('${p.id}')">Hapus</button>
        </div>
      </div>`;
    }).join('');
  };

  window.openProdModal=function(id){
    document.getElementById('prodEditId').value=id||'';
    if(id){
      const p=products.find(x=>x.id===id);
      document.getElementById('prodModalTitle').textContent='Edit Produk';
      document.getElementById('prodName').value=p.name;
      document.getElementById('prodCat').value=p.category||'Minuman Literan';
      document.getElementById('prodUnit').value=p.unit;
      document.getElementById('prodStock').value=p.stock;
      document.getElementById('prodMin').value=p.minStock||0;
      document.getElementById('prodOverhead').value=p.overhead||0;
      document.getElementById('prodMargin').value=p.margin||50;
      prodRows=(p.ingredients||[]).map(r=>({ingredientId:r.ingredientId,amount:r.amount}));
    }else{
      document.getElementById('prodModalTitle').textContent='Tambah Produk';
      document.getElementById('prodName').value='';
      document.getElementById('prodStock').value='';
      document.getElementById('prodMin').value='';
      document.getElementById('prodOverhead').value=0;
      document.getElementById('prodMargin').value=50;
      prodRows=[];
    }
    renderProdEditor();calcHPP();
    document.getElementById('prodModal').classList.add('show');
  };
  window.closeProdModal=function(){document.getElementById('prodModal').classList.remove('show');};

  function renderProdEditor(){
    const ed=document.getElementById('prodEditor');
    if(!ingredients.length){ed.innerHTML=`<p style="font-size:12px;color:var(--text-dim);text-align:center;padding:12px">Tambahkan bahan baku dulu di tab Stok Bahan.</p>`;return;}
    ed.innerHTML=prodRows.map((r,idx)=>{
      const ing=ingredients.find(i=>i.id===r.ingredientId);
      return`<div class="recipe-editor-item">
        <select onchange="updateProdRow(${idx},'ingredientId',this.value)">${ingredients.map(i=>`<option value="${i.id}"${i.id===r.ingredientId?' selected':''}>${i.name}</option>`).join('')}</select>
        <input type="number" value="${r.amount}" min="0" step="0.01" placeholder="Jml" onchange="updateProdRow(${idx},'amount',parseFloat(this.value))"/>
        <span class="unit-label">${ing?ing.unit:''}</span>
        <button class="btn-remove-recipe" onclick="removeProdRow(${idx})"><i class="fa-solid fa-xmark"></i></button>
      </div>`;
    }).join('');
  }
  window.addProdRow=function(){prodRows.push({ingredientId:ingredients[0]?.id||'',amount:0});renderProdEditor();calcHPP();};
  window.updateProdRow=function(idx,field,val){prodRows[idx][field]=val;if(field==='ingredientId')renderProdEditor();calcHPP();};
  window.removeProdRow=function(idx){prodRows.splice(idx,1);renderProdEditor();calcHPP();};

  window.submitProd=async function(){
    const btn=document.getElementById('prodSaveBtn');
    const id=document.getElementById('prodEditId').value;
    const name=document.getElementById('prodName').value.trim();
    const category=document.getElementById('prodCat').value;
    const unit=document.getElementById('prodUnit').value;
    const stock=parseFloat(document.getElementById('prodStock').value);
    const minStock=parseFloat(document.getElementById('prodMin').value)||0;
    const overhead=parseFloat(document.getElementById('prodOverhead').value)||0;
    const margin=parseFloat(document.getElementById('prodMargin').value)||0;
    const validIngredients=prodRows.filter(r=>r.ingredientId&&r.amount>0);

    if(!name||isNaN(stock)){toast('Nama dan stok wajib diisi.','error');return;}
    if(!validIngredients.length){toast('Tambahkan minimal 1 bahan baku.','error');return;}

    // Hitung HPP
    let totalBahan=0;
    for(const r of validIngredients){
      const ing=ingredients.find(i=>i.id===r.ingredientId);
      if(!ing||!ing.hargaBeli||!ing.unitMultiplier){toast(`Harga beli/unit multiplier ${ing?.name||'bahan'} belum diisi.`,'error');return;}
      totalBahan+=(ing.hargaBeli/ing.unitMultiplier)*r.amount;
    }
    const hppTotal=totalBahan+overhead;
    const hargaJual=Math.ceil(hppTotal*(1+margin/100)/1000)*1000;

    btn.disabled=true;btn.textContent='Menyimpan...';
    try{
      const batch=writeBatch(db);

      if(id){
        // Edit: update produk, tapi ga kurangin stok bahan baku lagi
        await updateDoc(doc(db,"finishedGoods",id),{
          name,category,unit,stock,minStock,overhead,margin,
          hppBahan:totalBahan,hppTotal,hargaJual,
          ingredients:validIngredients
        });
      }else{
        // Tambah baru: buat produk (stok awal cuma inisialisasi, tidak kurangi bahan baku)
        // Bahan baku dikurangi saat restock/produksi via + Stok, bukan saat pembuatan produk
        await addDoc(collection(db,"finishedGoods"),{
          name,category,unit,stock,minStock,overhead,margin,
          hppBahan:totalBahan,hppTotal,hargaJual,
          ingredients:validIngredients,
          createdAt:serverTimestamp()
        });
      }

      await Promise.all([loadIngredients(),loadProducts(),loadLogs()]);
      renderIngredients();renderProducts();renderLogs();checkAlerts();
      closeProdModal();
      toast(id?'✓ Produk diupdate':'✓ Produk dibuat','success');
    }catch(e){toast('Error: '+e.message,'error');}
    btn.disabled=false;btn.textContent='Simpan';
  };

  window.deleteProd=async function(id){
    const p=products.find(x=>x.id===id);if(!confirm(`Hapus "${p?.name}"?`))return;
    try{await deleteDoc(doc(db,"finishedGoods",id));await loadProducts();renderProducts();checkAlerts();toast('Produk dihapus','success');}catch(e){toast('Error: '+e.message,'error');}
  };

  window.openProdRestock=function(id){
    const p=products.find(x=>x.id===id);
    document.getElementById('prodRestockId').value=id;
    document.getElementById('prodRestockName').textContent=p.name;
    document.getElementById('prodRestockCurrent').textContent=`Stok saat ini: ${p.stock} ${p.unit}`;
    document.getElementById('prodRestockAmt').value='';document.getElementById('prodRestockNote').value='';
    document.getElementById('prodRestockModal').classList.add('show');
  };
  window.closeProdRestock=function(){document.getElementById('prodRestockModal').classList.remove('show');};
  window.submitProdRestock=async function(){
    const btn=document.getElementById('prodRestockSaveBtn');
    const id=document.getElementById('prodRestockId').value;
    const amt=parseFloat(document.getElementById('prodRestockAmt').value);
    const note=document.getElementById('prodRestockNote').value.trim()||'Produksi batch';
    if(isNaN(amt)||amt<=0){toast('Jumlah tidak valid.','error');return;}

    const p=products.find(x=>x.id===id);
    const validIngredients=(p.ingredients||[]).filter(r=>r.ingredientId&&r.amount>0);

    btn.disabled=true;btn.textContent='Menyimpan...';
    try{
      const batch=writeBatch(db);

      // Kurangin stok bahan baku
      for(const r of validIngredients){
        const ing=ingredients.find(i=>i.id===r.ingredientId);
        const deduct=r.amount*amt;
        if(ing.stock<deduct){toast(`Stok ${ing.name} tidak cukup (tersisa ${ing.stock} ${ing.unit}, butuh ${deduct} ${ing.unit})`,'error');btn.disabled=false;btn.textContent='Tambah Stok';return;}
        batch.update(doc(db,"ingredients",r.ingredientId),{stock:increment(-deduct)});

        const logRef=doc(collection(db,"stockLogs"));
        batch.set(logRef,{
          type:'ingredient',
          ingredientId:r.ingredientId,
          ingredientName:ing.name,
          unit:ing.unit,
          change:-deduct,
          note:`Produksi: ${p.name} +${amt}${p.unit}`,
          byName:currentUser.name,
          createdAt:serverTimestamp()
        });
      }

      // Tambah stok produk
      batch.update(doc(db,"finishedGoods",id),{stock:increment(amt)});

      // Log produk
      const prodLogRef=doc(collection(db,"stockLogs"));
      batch.set(prodLogRef,{
        type:'finishedGoods',
        itemId:id,
        itemName:p.name,
        unit:p.unit,
        change:amt,
        note:note,
        byName:currentUser.name,
        createdAt:serverTimestamp()
      });

      await batch.commit();
      await Promise.all([loadIngredients(),loadProducts(),loadLogs()]);
      renderIngredients();renderProducts();renderLogs();checkAlerts();
      closeProdRestock();
      toast(`✓ +${amt} ${p.unit} ditambahkan`,'success');
    }catch(e){toast('Error: '+e.message,'error');}
    btn.disabled=false;btn.textContent='Tambah Stok';
  };

  // ── RESEP MENU (existing, unchanged) ──
  window.renderRecipes=function(){
    const grid=document.getElementById('recipeGrid');
    if(!menuItems.length){grid.innerHTML=`<p style="color:var(--text-dim);font-size:14px">Belum ada menu.</p>`;return;}
    grid.innerHTML=menuItems.map(m=>{
      const r=m.recipe||[];
      const rows=r.length?r.map(x=>{
        let itemName='(dihapus)', itemUnit='';
        if(x.ingredientId?.startsWith('prod_')){
          const prodId=x.ingredientId.replace('prod_','');
          const prod=products.find(p=>p.id===prodId);
          if(prod){itemName=prod.name;itemUnit=prod.unit;}
        } else {
          const ingId=x.ingredientId?.startsWith('ing_')?x.ingredientId.replace('ing_',''):x.ingredientId;
          const ing=ingredients.find(i=>i.id===ingId||i.id===x.ingredientId);
          if(ing){itemName=ing.name;itemUnit=ing.unit;}
        }
        return`<div class="recipe-item"><span class="recipe-item-name">${itemName}</span><span class="recipe-item-amount">${x.amount} ${itemUnit}</span></div>`;
      }).join(''):`<div class="recipe-empty">Belum ada resep</div>`;
      return`<div class="recipe-card"><div class="recipe-card-head"><div><div class="recipe-name">${m.name}</div><div class="recipe-cat">${m.category||''}</div></div><button class="btn-sm" onclick="openRecipeModal('${m.id}')">Edit Resep</button></div>${rows}</div>`;
    }).join('');
  };
  window.openRecipeModal=function(menuId){
    const m=menuItems.find(x=>x.id===menuId);
    document.getElementById('recipeMenuId').value=menuId;
    document.getElementById('recipeModalTitle').textContent=`Resep: ${m.name}`;
    recipeRows=(m.recipe||[]).map(r=>({ingredientId:r.ingredientId,amount:r.amount}));
    renderRecipeEditor();document.getElementById('recipeModal').classList.add('show');
  };
  window.closeRecipeModal=function(){document.getElementById('recipeModal').classList.remove('show');};
  window.addRecipeRow=function(){recipeRows.push({ingredientId:ingredients[0]?.id||'',amount:0});renderRecipeEditor();};
  function renderRecipeEditor(){
    const ed=document.getElementById('recipeEditor');
    if(!ingredients.length && !products.length){ed.innerHTML=`<p style="font-size:12px;color:var(--text-dim);text-align:center;padding:12px">Tambahkan bahan baku atau produk dulu.</p>`;return;}

    // Build options with optgroups
    let optionsHtml = '';
    if(ingredients.length){
      optionsHtml += `<optgroup label="Bahan Baku">${ingredients.map(i=>`<option value="ing_${i.id}">${i.name} (${i.unit})</option>`).join('')}</optgroup>`;
    }
    if(products.length){
      optionsHtml += `<optgroup label="Produk Jadi">${products.map(p=>`<option value="prod_${p.id}">${p.name} (${p.unit})</option>`).join('')}</optgroup>`;
    }

    ed.innerHTML=recipeRows.map((r,idx)=>{
      // Determine type and find item
      let item, itemType, selectValue;
      if(r.ingredientId?.startsWith('prod_')){
        itemType = 'prod';
        const prodId = r.ingredientId.replace('prod_','');
        item = products.find(p=>p.id===prodId);
        selectValue = r.ingredientId;
      } else {
        itemType = 'ing';
        const ingId = r.ingredientId?.startsWith('ing_') ? r.ingredientId.replace('ing_','') : r.ingredientId;
        item = ingredients.find(i=>i.id===ingId || i.id===r.ingredientId);
        selectValue = item ? (r.ingredientId?.startsWith('ing_') ? r.ingredientId : 'ing_' + r.ingredientId) : '';
      }

      return`<div class="recipe-editor-item">
        <select onchange="updateRecipeRow(${idx},'ingredientId',this.value)">${optionsHtml.replace(new RegExp('value="' + selectValue + '"'), 'value="' + selectValue + '" selected')}</select>
        <input type="number" value="${r.amount}" min="0" step="0.01" placeholder="Jml" onchange="updateRecipeRow(${idx},'amount',parseFloat(this.value))"/>
        <span class="unit-label">${item?item.unit:''}</span>
        <button class="btn-remove-recipe" onclick="removeRecipeRow(${idx})"><i class="fa-solid fa-xmark"></i></button>
      </div>`;
    }).join('');
  }
  window.updateRecipeRow=function(idx,field,val){recipeRows[idx][field]=val;if(field==='ingredientId')renderRecipeEditor();};
  window.removeRecipeRow=function(idx){recipeRows.splice(idx,1);renderRecipeEditor();};
  window.submitRecipe=async function(){
    const btn=document.getElementById('recipeSaveBtn');
    const menuId=document.getElementById('recipeMenuId').value;
    const valid=recipeRows.filter(r=>r.ingredientId&&r.amount>0);
    btn.disabled=true;btn.textContent='Menyimpan...';
    try{await updateDoc(doc(db,"menu",menuId),{recipe:valid});await loadMenu();renderRecipes();closeRecipeModal();toast('✓ Resep disimpan','success');}
    catch(e){toast('Error: '+e.message,'error');}
    btn.disabled=false;btn.textContent='Simpan Resep';
  };

  // ── LOGS ──
  function renderLogs(){
    document.getElementById('logTbody').innerHTML=stockLogs.length?stockLogs.map(l=>{
      const isPos=l.change>0;const col=isPos?'var(--green)':'var(--red)';
      const ts=l.createdAt?.toDate?l.createdAt.toDate():new Date((l.createdAt?.seconds||0)*1000);
      const tipe=l.type==='finishedGoods'?'🥤 Produk':'📦 Bahan';
      const itemName=l.itemName||l.ingredientName||'—';
      return`<tr>
        <td style="font-size:12px;color:var(--text-dim)">${ts.toLocaleString('id-ID',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'})}</td>
        <td><span class="badge ${l.type==='finishedGoods'?'badge-accent':'badge-green'}">${tipe}</span></td>
        <td>${itemName}</td>
        <td style="color:${col};font-weight:600">${isPos?'+':''}${l.change} ${l.unit}</td>
        <td style="font-size:12px;color:var(--text-dim)">${l.note||'—'}</td>
        <td style="font-size:12px;color:var(--text-dim)">${l.byName||'—'}</td>
      </tr>`;
    }).join(''):`<tr><td colspan="6" class="empty-cell">Belum ada riwayat.</td></tr>`;
  }

  function toast(msg,type=''){const t=document.getElementById('toast');t.textContent=msg;t.className=`toast ${type} show`;setTimeout(()=>t.classList.remove('show'),2400);}
  document.getElementById('btnLogout').addEventListener('click',()=>signOut(auth).then(()=>location.href="login.html"));
</script>
<script src="nav-scroll.js"></script>
</body>
</html>